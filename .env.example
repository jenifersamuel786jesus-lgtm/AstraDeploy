# For a local demo, start the app with SQLite and no cloud account credentials.
# Managed Webdev injects DATABASE_URL and Manus OAuth values when configured.
DATABASE_URL=sqlite:///./astradeploy.db
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=
# Local HTTP only: set true so the secure session cookie works over localhost.
# Keep false in public HTTPS Preview and production.
ASTRA_LOCAL_HTTP_COOKIES=true
# Live cloud adapters remain disabled until separately configured and approved.
ASTRA_CLOUD_MODE=demo
